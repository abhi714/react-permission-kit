{
  "name": "react-permission-kit",
  "version": "0.1.0",
  "description": "Lightweight permission management for React applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DOCUMENTATION.md"
  ],
  "keywords": [
    "react",
    "permissions",
    "rbac",
    "pbac",
    "authorization",
    "access-control",
    "roles",
    "can",
    "permission-guard",
    "typescript"
  ],
  "author": "Abhishek Bhatt",
  "license": "ISC",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}